# Postgres connection string.
DATABASE_URL=postgres://localhost:5432/accred_automation

# Encrypts stored API keys and connection secrets. 32+ random characters.
# Changing it makes every stored secret unreadable.
APP_SECRET=

# Public address of this app. Optional in production: without it the app uses the domain
# each request arrives on. Needed for local development.
APP_URL=https://agent.accred.sh

# Bearer token for POST /api/cron/tick when an external cron drives the scheduler.
CRON_SECRET=

# "internal" (default) runs the scheduler inside the server process.
# Set to "off" on serverless hosts and call /api/cron/tick every minute instead.
SCHEDULER=internal

# Token of the shared Telegram bot from @BotFather. With it set, users link a chat
# by pressing Start in the bot, and the bot is the Telegram agent (docs/PLAN_TELEGRAM_AGENT.md):
# users paste their API key in the chat and talk to it. Without it, they paste their own bot token and chat ID.
TELEGRAM_BOT_TOKEN=

# OAuth client from Google Cloud (APIs & Services > Credentials), for the Gmail connection.
# Its redirect URI must be APP_URL + /api/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trading agents (see docs/TRADING_AGENT.md).
# Set to "on" to let agents trade with real funds on Robinhood Chain. Anything else, or unset:
# no trade can be signed and no agent can be started.
# LIVE_TRADING=on
# Raises the request limit on swap routes from LI.FI.
# LIFI_API_KEY=
# Market data whose request limit belongs to your key. The free providers limit by address and answer
# HTTP 429 to shared hosts such as Render. Set one of these; a paid key is needed for agents that run all day.
# COINGECKO_PRO_API_KEY=
# COINGECKO_DEMO_API_KEY=
# Encrypts trading-wallet keys, separately from everything APP_SECRET protects. 32+ random characters.
# Set it before the first wallet is created and never change it: that makes every stored wallet key unreadable.
# TRADING_WALLET_SECRET=
# A dedicated Robinhood Chain RPC endpoint (HTTPS), tried before the rate-limited public ones.
# ROBINHOOD_RPC_URL=

# Optional overrides.
# ACCRED_BASE_URL=https://accred.sh
# ROUTER_SMART_MODEL=
# ROUTER_FAST_MODEL=
# ROUTER_TOP_MODEL=
